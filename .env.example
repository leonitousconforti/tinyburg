# --- tinyburg.app -----------------------------------------------------------
TINYBURGAPP_GOOGLE_CLIENT_ID=
TINYBURGAPP_GOOGLE_CLIENT_SECRET=
TINYBURGAPP_DISCORD_CLIENT_ID=
TINYBURGAPP_DISCORD_CLIENT_SECRET=
# Nimblebit's shared secret, so tinyburg.app can act on linked towers directly
TINYBURGAPP_NIMBLEBIT_AUTH_KEY=
TINYBURGAPP_OIDC_PRIVATE_JWK='{"key_ops":["sign"],"kty":"EC","x":"Gurg4mwuxJjOjFPm2NiPPEmGbomQsnn7eSXOex3EOds","y":"MWg3Vxz60HhPP7NEKP1gjJAfTxJuWd_fodbVzzfLH-Y","crv":"P-256","d":"J5hPet25Uanna7BiHYnkqZoQkV7vaR2ANRow4jgZJF4","alg":"ES256","kid":"dev"}'

# --- authproxy ---------------------------------------------------------------
AUTHPROXY_ADMIN_PASSWORD=admin
AUTHPROXY_ADMIN_PLAYER_IDS=ADMIN
# Per-game Nimblebit secret salts, one per proxied game (extracted from NBSync._ss / genHash)
AUTHPROXY_NIMBLEBIT_AUTH_KEY=
AUTHPROXY_POCKETPLANES_NIMBLEBIT_AUTH_KEY=
AUTHPROXY_POCKETTRAINS_NIMBLEBIT_AUTH_KEY=
AUTHPROXY_LEGOTOWER_NIMBLEBIT_AUTH_KEY=
AUTHPROXY_DISCOZOO_NIMBLEBIT_AUTH_KEY=
AUTHPROXY_BITCITY_NIMBLEBIT_AUTH_KEY=
AUTHPROXY_TINYTOWERVEGAS_NIMBLEBIT_AUTH_KEY=

# --- social-circles ----------------------------------------------------------
SOCIALCIRCLES_GRANT_SEALING_KEY=dev-only-grant-sealing-key

# --- treasury ----------------------------------------------------------------
TREASURY_GRANT_SEALING_KEY=dev-only-treasury-sealing-key
# The vault: the treasury-owned tower whose gift queue holds every escrow
# (the auth key is the tower's player_ss, a UUID)
TREASURY_VAULT_PLAYER_ID=
TREASURY_VAULT_AUTH_KEY=
# Nimblebit's shared secret, so the vault can sign its own calls (unused when
# TREASURY_NIMBLEBIT_HOST points at the authproxy or a fake, which sign server-side)
TREASURY_NIMBLEBIT_AUTH_KEY=
TREASURY_NIMBLEBIT_HOST=
# Required outside development, for RFC 7591 registration at tinyburg.app
TREASURY_TINYBURG_OAUTH_REGISTRATION_TOKEN=

# --- discord-bot (disabled by default) --------------------------------------
DISCORDBOT_TOKEN=
DISCORDBOT_APPLICATION_ID=

# --- archivist (disabled by default) -----------------------------------------
ARCHIVIST_S3_ENDPOINT=http://127.0.0.1:8333
ARCHIVIST_S3_FORCE_PATH_STYLE=true
ARCHIVIST_SPACES_KEY=tinyburg-local
ARCHIVIST_SPACES_SECRET=tinyburg-local-secret
ARCHIVIST_SPACES_BUCKET=tinyburg

# --- auto-gold-bits and doorman-clone (disabled by default) -----------------
AUTOGOLDBITS_AUTHPROXY_AUTH_KEY=
DOORMANCLONE_AUTHPROXY_AUTH_KEY=

# --- fake Nimblebit mode (dev walkthrough) -----------------------------------
# Uncomment to point tinyburg.app and the treasury at the in-memory fake
# (enable the fake-nimblebit worker in process-compose first), so the whole
# trade loop runs without touching sync.nimblebit.com. See
# apps/treasury/README.md for the walkthrough.
# TINYBURGAPP_NIMBLEBIT_HOST=http://localhost:3005
# TINYBURGAPP_NIMBLEBIT_AUTH_KEY=fake
# TREASURY_NIMBLEBIT_HOST=http://localhost:3005
# TREASURY_NIMBLEBIT_AUTH_KEY=fake

# --- tests ------------------------------------------------------------------
NIMBLEBIT_AUTH_KEY=

# --- tinyburg.app -----------------------------------------------------------
TINYBURGAPP_GOOGLE_CLIENT_ID=
TINYBURGAPP_GOOGLE_CLIENT_SECRET=
TINYBURGAPP_DISCORD_CLIENT_ID=
TINYBURGAPP_DISCORD_CLIENT_SECRET=
# Nimblebit's shared secret, so tinyburg.app can act on linked towers directly
TINYBURGAPP_NIMBLEBIT_AUTH_KEY=
# RSA private JWK (2048 bits or more, with a kid) that signs RS256 ID tokens. Generate one with
# node -e 'const {generateKeyPairSync}=require("crypto");const k=generateKeyPairSync("rsa",{modulusLength:2048}).privateKey.export({format:"jwk"});console.log(JSON.stringify({...k,kid:"dev",alg:"RS256",use:"sig"}))'
TINYBURGAPP_OIDC_PRIVATE_JWK=
# Seals OAuth consent, codes and tokens: 32 or more random bytes, base64url. Keep it apart from every other secret
# node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
TINYBURGAPP_OAUTH_SIGNING_KEY=

# --- authproxy ---------------------------------------------------------------
AUTHPROXY_ADMIN_PASSWORD=admin
AUTHPROXY_ADMIN_PLAYER_IDS=ADMIN
# Per-game Nimblebit secret salts, one per proxied game (extracted from NBSync._ss / genHash)
AUTHPROXY_TINYTOWER_NIMBLEBIT_AUTH_KEY=
AUTHPROXY_TINYTOWERCLASSIC_NIMBLEBIT_AUTH_KEY=
AUTHPROXY_POCKETPLANES_NIMBLEBIT_AUTH_KEY=
AUTHPROXY_POCKETTRAINS_NIMBLEBIT_AUTH_KEY=
AUTHPROXY_LEGOTOWER_NIMBLEBIT_AUTH_KEY=
AUTHPROXY_DISCOZOO_NIMBLEBIT_AUTH_KEY=
AUTHPROXY_BITCITY_NIMBLEBIT_AUTH_KEY=
AUTHPROXY_TINYTOWERVEGAS_NIMBLEBIT_AUTH_KEY=

# --- social-circles ----------------------------------------------------------
SOCIALCIRCLES_GRANT_SEALING_KEY=dev-only-grant-sealing-key
# The study is an ordinary OAuth client of tinyburg.app. Register it once against the dev stack:
# curl -H 'Content-Type: application/json' http://localhost:3000/oauth/register -d '{"software_id":"tinyburg-social-circles","client_name":"TinyTower Social Circles","redirect_uris":["http://localhost:3002/auth/callback"],"token_endpoint_auth_method":"client_secret_post","grant_types":["authorization_code","refresh_token"],"scope":"openid profile tinytower:list_accounts tinytower:pull_save tinytowerclassic:list_accounts tinytowerclassic:pull_save offline_access"}'
SOCIALCIRCLES_TINYBURG_CLIENT_ID=
SOCIALCIRCLES_TINYBURG_CLIENT_SECRET=

# --- discord-bot (disabled by default) --------------------------------------
DISCORDBOT_TOKEN=
DISCORDBOT_APPLICATION_ID=

# --- archivist (disabled by default) -----------------------------------------
ARCHIVIST_S3_ENDPOINT=http://127.0.0.1:8333
ARCHIVIST_S3_FORCE_PATH_STYLE=true
ARCHIVIST_SPACES_KEY=tinyburg-local
ARCHIVIST_SPACES_SECRET=tinyburg-local-secret
ARCHIVIST_SPACES_BUCKET=tinyburg

# --- auto-gold-bits and doorman-clone (disabled by default) -----------------
AUTOGOLDBITS_AUTHPROXY_AUTH_KEY=
DOORMANCLONE_AUTHPROXY_AUTH_KEY=

# --- tests ------------------------------------------------------------------
NIMBLEBIT_AUTH_KEY=

# Copy to `.env.dev` and fill in. Gitignored, and never read into the nix store.
#
# Only secrets belong here. Ports, connection strings, redirect uris and issuer
# urls are set by `nix/dev.nix` and deliberately override anything set here, so
# that the wiring between services cannot drift from the stack that runs them.

# OAuth apps registered for development, not the production ones. The redirect
# uris to register are:
#   http://localhost:3000/auth/google/callback
#   http://localhost:3000/auth/discord/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Only needed to run the workers or pull SDK fixtures.
# NIMBLEBIT_AUTH_KEY=

# Only needed by archivist, which still talks to DigitalOcean Spaces rather
# than the MinIO in this stack.
# SPACES_KEY=
# SPACES_SECRET=

{
    "name": "@tinyburg/disco-zoo-sdk",
    "version": "0.2.0",
    "description": "api for the mobile game Disco Zoo by Nimblebit",
    "keywords": [
        "disco-zoo-sdk",
        "nimblebit"
    ],
    "homepage": "https://github.com/leonitousconforti/tinyburg",
    "license": "GPL-3.0-only",
    "author": "Leo Conforti <leo@leoconforti.us> (https://leoconforti.us)",
    "repository": {
        "type": "git",
        "url": "https://github.com/leonitousconforti/tinyburg.git",
        "directory": "packages/disco-zoo-sdk"
    },
    "files": [
        "src/**/*.ts",
        "dist/**/*.js",
        "dist/**/*.js.map",
        "dist/**/*.d.ts",
        "dist/**/*.d.ts.map"
    ],
    "type": "module",
    "sideEffects": [],
    "exports": {
        "./package.json": "./package.json",
        ".": "./src/index.ts",
        "./*": "./src/*.ts",
        "./internal/*": null
    },
    "publishConfig": {
        "exports": {
            "./package.json": "./package.json",
            ".": "./dist/index.js",
            "./*": "./dist/*.js",
            "./internal/*": null
        },
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "codegen": "build-utils prepare-v4",
        "build": "tsc -b tsconfig.build.json && pnpm babel",
        "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
        "check": "tsc -b tsconfig.json",
        "generate": "node ./frida/Generate.ts"
    },
    "dependencies": {
        "@tinyburg/nimblebit-sdk": "workspace:*"
    },
    "devDependencies": {
        "@effect/platform-node": "4.1.2",
        "@efffrida/il2cpp-bridge": "0.0.60",
        "@efffrida/polyfills": "0.0.23",
        "@tinyburg/insight": "workspace:*",
        "@types/frida-gum": "19.13.0",
        "@yielded/auth": "0.1.0-beta.47",
        "effect": "4.1.2",
        "frida-il2cpp-bridge": "0.14.0"
    },
    "peerDependencies": {
        "@yielded/auth": "0.1.0-beta.47",
        "effect": "4.1.2"
    }
}

{
    "name": "@tinyburg/tinytower-sdk",
    "version": "0.2.1",
    "description": "api for the mobile game TinyTower by Nimblebit",
    "keywords": [
        "nimblebit",
        "tinytower",
        "tinytowers"
    ],
    "homepage": "https://github.com/leonitousconforti/tinyburg",
    "license": "GPL-3.0-only",
    "author": "Leo Conforti <leo@leoconforti.us> (https://leoconforti.us)",
    "repository": {
        "type": "git",
        "url": "https://github.com/leonitousconforti/tinyburg.git",
        "directory": "packages/tinytower-sdk"
    },
    "files": [
        "src/**/*.ts",
        "dist/**/*.js",
        "dist/**/*.js.map",
        "dist/**/*.d.ts",
        "dist/**/*.d.ts.map"
    ],
    "type": "module",
    "sideEffects": [],
    "exports": {
        "./package.json": "./package.json",
        ".": "./src/index.ts",
        "./*": "./src/*.ts",
        "./internal/*": null
    },
    "publishConfig": {
        "exports": {
            "./package.json": "./package.json",
            ".": "./dist/index.js",
            "./*": "./dist/*.js",
            "./internal/*": null
        },
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "codegen": "build-utils prepare-v4",
        "build": "tsc -b tsconfig.build.json && pnpm babel",
        "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
        "check": "tsc -b tsconfig.json",
        "test": "vitest",
        "generate": "node ./scripts/GenerateData.ts"
    },
    "dependencies": {
        "@tinyburg/nimblebit-sdk": "workspace:*",
        "pako": "3.0.3"
    },
    "devDependencies": {
        "@effect/platform-node": "4.1.2",
        "@effect/vitest": "4.1.2",
        "@efffrida/frida-tools": "0.0.67",
        "@efffrida/gplayapi": "0.0.41",
        "@tinyburg/insight": "workspace:*",
        "@yielded/auth": "0.1.0-beta.47",
        "effect": "4.1.2",
        "redis": "6.3.1",
        "vite": "8.3.5",
        "vitest": "5.0.5"
    },
    "peerDependencies": {
        "@yielded/auth": "0.1.0-beta.47",
        "effect": "4.1.2"
    }
}

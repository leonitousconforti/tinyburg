{
    "name": "@tinyburg/tinytower-sdk",
    "version": "0.0.1",
    "description": "api for the mobile game TinyTower by Nimblebit",
    "keywords": [
        "nimblebit",
        "tinytower",
        "tinytowers"
    ],
    "homepage": "https://github.com/leonitousconforti/tinyburg",
    "license": "GPL-3.0-only",
    "author": "Leo Conforti <leo@leoconforti.us> (https://leoconforti.us)",
    "repository": {
        "type": "git",
        "url": "https://github.com/leonitousconforti/tinyburg.git",
        "directory": "packages/tinytower-sdk"
    },
    "files": [
        "src/**/*.ts",
        "dist/**/*.js",
        "dist/**/*.js.map",
        "dist/**/*.d.ts",
        "dist/**/*.d.ts.map"
    ],
    "type": "module",
    "sideEffects": [],
    "exports": {
        "./package.json": "./package.json",
        ".": "./src/index.ts",
        "./*": "./src/*.ts",
        "./internal/*": null
    },
    "publishConfig": {
        "exports": {
            "./package.json": "./package.json",
            ".": "./dist/index.js",
            "./*": "./dist/*.js",
            "./internal/*": null
        },
        "access": "public"
    },
    "scripts": {
        "build": "tsc -b tsconfig.build.json && babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
        "check": "tsc -b tsconfig.json",
        "codegen": "build-utils prepare-v4",
        "coverage": "vitest --coverage",
        "generate": "node ./scripts/GenerateData.ts",
        "test": "vitest"
    },
    "dependencies": {
        "@tinyburg/nimblebit-sdk": "workspace:*",
        "pako": "2.1.0"
    },
    "devDependencies": {
        "@bufbuild/protobuf": "2.13.0",
        "@effect/platform-node": "4.0.0-beta.100",
        "@effect/vitest": "4.0.0-beta.100",
        "@efffrida/frida-tools": "0.0.45",
        "@efffrida/gplayapi": "0.0.22",
        "@tinyburg/insight": "workspace:*",
        "@types/pako": "2.0.4",
        "effect": "4.0.0-beta.100",
        "ioredis": "5.11.1",
        "vite": "8.0.16",
        "vitest": "4.1.8"
    },
    "peerDependencies": {
        "effect": "4.0.0-beta.100"
    },
    "tags": [
        "nimblebit",
        "tinytower",
        "tinytowers"
    ]
}

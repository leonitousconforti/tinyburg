{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "../../tsconfig.base.jsonc",
    "include": ["frida/Agent.ts", "frida/Rpcs.ts"],
    "references": [{ "path": "../insight/tsconfig.src-frida.json" }, { "path": "../insight/tsconfig.src-shared.json" }],
    "compilerOptions": {
        "tsBuildInfoFile": ".tsbuildinfo/frida.tsbuildinfo",
        "outDir": ".tsbuildinfo/frida",
        "noEmit": true,
        "rewriteRelativeImportExtensions": false,
        "allowImportingTsExtensions": true,
        "types": ["frida-gum"]
    }
}

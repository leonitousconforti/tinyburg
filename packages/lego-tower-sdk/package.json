{
    "name": "@tinyburg/lego-tower-sdk",
    "version": "0.1.1",
    "description": "api for the mobile game LEGO Tower by Nimblebit",
    "keywords": [
        "lego-tower-sdk",
        "nimblebit"
    ],
    "homepage": "https://github.com/leonitousconforti/tinyburg",
    "license": "GPL-3.0-only",
    "author": "Leo Conforti <leo@leoconforti.us> (https://leoconforti.us)",
    "repository": {
        "type": "git",
        "url": "https://github.com/leonitousconforti/tinyburg.git",
        "directory": "packages/lego-tower-sdk"
    },
    "files": [
        "src/**/*.ts",
        "dist/**/*.js",
        "dist/**/*.js.map",
        "dist/**/*.d.ts",
        "dist/**/*.d.ts.map"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        "./package.json": "./package.json",
        ".": "./src/index.ts",
        "./*": "./src/*.ts",
        "./internal/*": null
    },
    "publishConfig": {
        "exports": {
            "./package.json": "./package.json",
            ".": "./dist/index.js",
            "./*": "./dist/*.js",
            "./internal/*": null
        },
        "access": "public"
    },
    "scripts": {
        "build": "tsc -b tsconfig.build.json && babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
        "check": "tsc -b tsconfig.json",
        "codegen": "build-utils prepare-v4"
    },
    "dependencies": {
        "@tinyburg/nimblebit-sdk": "workspace:*"
    },
    "devDependencies": {
        "@yielded/auth": "0.1.0-beta.47",
        "effect": "4.1.1"
    },
    "peerDependencies": {
        "@yielded/auth": "0.1.0-beta.47",
        "effect": "4.1.1"
    }
}

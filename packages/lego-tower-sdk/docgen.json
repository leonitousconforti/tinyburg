{
    "$schema": "../../node_modules/@effect/docgen/schema.json",
    "srcLink": "https://github.com/leonitousconforti/tinyburg/blob/main/packages/lego-tower-sdk/src/",
    "exclude": ["src/index.ts", "src/internal/**/*.ts"],
    "projectHomepage": "https://github.com/leonitousconforti/tinyburg/tree/main/packages/lego-tower-sdk",
    "examplesCompilerOptions": {
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "moduleResolution": "Bundler",
        "module": "ES2022",
        "target": "ES2022",
        "lib": ["ES2022"],
        "baseUrl": "../../",
        "paths": {
            "@tinyburg/lego-tower-sdk": ["./src/index.js"],
            "@tinyburg/lego-tower-sdk/*": ["./src/*.js"]
        }
    }
}

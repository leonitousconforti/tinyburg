{
    "name": "@tinyburg/insight",
    "version": "0.2.1",
    "description": "provides information into and about TinyTower using frida",
    "keywords": [
        "nimblebit",
        "tinytower",
        "tinytowers"
    ],
    "homepage": "https://github.com/leonitousconforti/tinyburg",
    "license": "GPL-3.0-only",
    "author": "Leo Conforti <leo@leoconforti.us> (https://leoconforti.us)",
    "repository": {
        "type": "git",
        "url": "https://github.com/leonitousconforti/tinyburg.git",
        "directory": "packages/insight"
    },
    "files": [
        "src/**/*.ts",
        "dist/**/*.js",
        "dist/**/*.js.map",
        "dist/**/*.d.ts",
        "dist/**/*.d.ts.map"
    ],
    "type": "module",
    "sideEffects": [],
    "exports": {
        "./package.json": "./package.json",
        "./node": "./src/node/index.ts",
        "./*": "./src/*.ts",
        "./internal/*": null,
        "./*/index": null
    },
    "publishConfig": {
        "exports": {
            "./package.json": "./package.json",
            "./node": "./dist/node/index.js",
            "./*": "./dist/*.js",
            "./internal/*": null,
            "./*/index": null
        },
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "codegen": "build-utils prepare-v4",
        "build": "tsc -b tsconfig.build.json && pnpm babel",
        "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
        "check": "tsc -b tsconfig.json"
    },
    "dependencies": {
        "@bufbuild/protobuf": "2.16.0",
        "@efffrida/frida-tools": "0.0.64",
        "@efffrida/gplayapi": "0.0.40",
        "@efffrida/il2cpp-bridge": "0.0.59",
        "@efffrida/platform": "0.0.51",
        "@efffrida/polyfills": "0.0.22",
        "@efffrida/rpc": "0.0.67",
        "frida": "17.25.1",
        "frida-il2cpp-bridge": "0.14.0"
    },
    "devDependencies": {
        "@types/frida-gum": "19.12.0",
        "effect": "4.1.1"
    },
    "peerDependencies": {
        "effect": "4.1.1"
    },
    "engines": {
        "node": ">=24"
    }
}

{
    "name": "@tinyburg/insight",
    "version": "0.1.0",
    "description": "provides information into and about TinyTower using frida",
    "keywords": [
        "nimblebit",
        "tinytower",
        "tinytowers"
    ],
    "homepage": "https://github.com/leonitousconforti/tinyburg",
    "license": "GPL-3.0-only",
    "author": "Leo Conforti <leo@leoconforti.us> (https://leoconforti.us)",
    "repository": {
        "type": "git",
        "url": "https://github.com/leonitousconforti/tinyburg.git",
        "directory": "packages/insight"
    },
    "files": [
        "src/**/*.ts",
        "dist/**/*.js",
        "dist/**/*.js.map",
        "dist/**/*.d.ts",
        "dist/**/*.d.ts.map"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        "./package.json": "./package.json",
        ".": "./src/index.ts",
        "./*": "./src/*.ts",
        "./internal/*": null
    },
    "publishConfig": {
        "exports": {
            "./package.json": "./package.json",
            ".": "./dist/index.js",
            "./*": "./dist/*.js",
            "./internal/*": null
        },
        "access": "public"
    },
    "scripts": {
        "build": "tsc -b tsconfig.build.json && babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
        "check": "tsc -b tsconfig.json",
        "codegen": "build-utils prepare-v4"
    },
    "dependencies": {
        "@bufbuild/protobuf": "2.13.0",
        "@efffrida/frida-tools": "0.0.47",
        "@efffrida/gplayapi": "0.0.25",
        "@efffrida/il2cpp-bridge": "0.0.43",
        "@efffrida/platform": "0.0.35",
        "@efffrida/polyfills": "0.0.14",
        "@efffrida/rpc": "0.0.50",
        "frida": "17.16.4",
        "frida-il2cpp-bridge": "0.13.1"
    },
    "devDependencies": {
        "@types/frida-gum": "19.10.0",
        "effect": "4.0.0-beta.102"
    },
    "peerDependencies": {
        "effect": "4.0.0-beta.102"
    },
    "tags": [
        "nimblebit",
        "tinytower",
        "tinytowers"
    ]
}

---
import CloudsLayout from "../layouts/CloudsLayout.astro";
---

<CloudsLayout title="Page Not Found | Tinyburg" description="The page you were looking for could not be found.">
    <main class="relative z-10 flex min-h-screen flex-col items-center justify-center px-6 py-16 text-center">
        <div class="tower mb-10" aria-hidden="true">
            <div class="floor roof">🏗️</div>
            <div class="floor food">🍕 Food</div>
            <div class="floor missing">404</div>
            <div class="floor recreation">🎮 Recreation</div>
            <div class="floor lobby">🚪 Lobby</div>
        </div>

        <h1
            class="font-pixel text-xl leading-relaxed text-white drop-shadow-[3px_3px_0_var(--color-dark-blue)] sm:text-3xl"
        >
            Floor Not Found
        </h1>
        <p class="mt-4 max-w-md text-xl text-white drop-shadow-[2px_2px_0_rgba(0,0,0,0.3)] sm:text-2xl">
            Maybe the bitizens moved this floor? Try the lobby instead!
        </p>

        <div class="mt-10 flex flex-wrap justify-center gap-4">
            <a
                href="/"
                class="font-pixel bg-gold text-dark-blue shadow-pixel hover:shadow-pixel-hover px-8 py-4 text-sm transition-all hover:-translate-x-0.5 hover:-translate-y-0.5 hover:bg-[#ffe44d]"
            >
                Go Home
            </a>
            <button
                onclick="history.back()"
                class="font-pixel shadow-pixel hover:shadow-pixel-hover border-3 cursor-pointer border-white bg-transparent px-8 py-4 text-sm text-white transition-all hover:-translate-x-0.5 hover:-translate-y-0.5 hover:bg-white/10"
            >
                Go Back
            </button>
        </div>
    </main>
</CloudsLayout>

<style>
    .tower {
        display: flex;
        flex-direction: column;
        gap: 2px;
        background: var(--color-dark-blue);
        padding: 8px;
        border-radius: 8px 8px 4px 4px;
        box-shadow: var(--shadow-pixel-hover);
    }

    .floor {
        font-family: var(--font-mono);
        font-size: 1.2rem;
        line-height: 1.5rem;
        padding: 0.9rem 2rem;
        text-align: center;
        min-width: 230px;
        animation: floorPop 0.5s ease-out backwards;
    }

    .floor:nth-child(1) {
        animation-delay: 0.1s;
    }
    .floor:nth-child(2) {
        animation-delay: 0.2s;
    }
    .floor:nth-child(4) {
        animation-delay: 0.4s;
    }
    .floor:nth-child(5) {
        animation-delay: 0.5s;
    }

    .floor.roof {
        background: linear-gradient(135deg, #8b4513, #a0522d);
        color: white;
        border-radius: 8px 8px 0 0;
    }
    .floor.food {
        background: var(--color-floor-food);
    }
    .floor.recreation {
        background: var(--color-floor-recreation);
    }
    .floor.lobby {
        background: #ddd;
        border-radius: 0 0 4px 4px;
    }

    .floor.missing {
        font-family: var(--font-pixel);
        font-size: 0.9rem;
        color: var(--color-gold);
        border: 2px dashed rgba(255, 255, 255, 0.4);
        border-radius: 4px;
        padding: calc(0.9rem - 2px) 2rem;
        animation:
            floorPop 0.5s ease-out 0.3s backwards,
            vacancy 2.4s ease-in-out 1.2s infinite;
    }

    @keyframes floorPop {
        from {
            opacity: 0;
            transform: translateX(-20px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @keyframes vacancy {
        0%,
        100% {
            opacity: 1;
        }
        50% {
            opacity: 0.45;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .floor {
            animation: none;
        }
    }
</style>

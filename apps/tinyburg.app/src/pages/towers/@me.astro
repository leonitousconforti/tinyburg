---
import { DateTime, Option } from "effect";

import CloudsLayout from "../../layouts/CloudsLayout.astro";

const maybeAccount = Astro.locals.account;
if (Option.isNone(maybeAccount)) {
    return Astro.redirect("/login");
}
const { user } = maybeAccount.value;

// Linked towers and connected sign-in providers aren't queryable from the
// repository yet, so those sections render their empty/default states.
const avatarUrl = Option.getOrNull(user.avatarUrl);
const avatarInitial = user.displayName.charAt(0).toUpperCase() || "?";
const mayorSince = DateTime.format(user.createdAt, { locale: "en-US", month: "long", year: "numeric" });
const lastLogin = DateTime.format(user.lastLoginAt, {
    locale: "en-US",
    month: "long",
    day: "numeric",
    year: "numeric",
});
---

<CloudsLayout
    title="My Towers | Tinyburg"
    description="Manage your linked TinyTower saves, connected sign-in providers, and Tinyburg account."
>
    <div class="relative z-10 flex min-h-screen flex-col items-center p-8 pt-24">
        <a
            href="/"
            class="font-pixel bg-dark-blue/80 shadow-pixel hover:shadow-pixel-hover absolute top-8 left-8 rounded px-4 py-3 text-[0.7rem] text-white transition-all hover:-translate-x-0.5 hover:-translate-y-0.5"
        >
            ← Back to Home
        </a>

        <div class="flex w-full max-w-2xl flex-col gap-6">
            <section class="bg-card-bg shadow-pixel-hover border-gold w-full rounded-2xl border-3 p-8">
                <div class="flex flex-wrap items-center gap-4">
                    {
                        avatarUrl !== null ? (
                            <img
                                src={avatarUrl}
                                alt={`Avatar for ${user.displayName}`}
                                referrerpolicy="no-referrer"
                                class="h-16 w-16 shrink-0 rounded-lg border-2 border-gray-300 bg-white object-cover"
                            />
                        ) : (
                            <div
                                aria-hidden="true"
                                class="bg-sky-blue font-pixel flex h-16 w-16 shrink-0 items-center justify-center rounded-lg border-2 border-gray-300 text-2xl text-white"
                            >
                                {avatarInitial}
                            </div>
                        )
                    }
                    <div class="min-w-0 flex-1">
                        <h1 class="font-pixel mb-2 text-lg break-words text-gray-800">{user.displayName}</h1>
                        <p class="font-mono text-xl text-gray-600">🏙️ Mayor since {mayorSince}</p>
                        <p class="font-mono text-base text-gray-500">Last login {lastLogin}</p>
                    </div>
                    <a
                        href="/logout"
                        class="font-pixel bg-dark-blue/80 shadow-pixel hover:shadow-pixel-hover shrink-0 rounded px-4 py-3 text-[0.7rem] text-white no-underline transition-all hover:-translate-x-0.5 hover:-translate-y-0.5"
                    >
                        Sign Out
                    </a>
                </div>
            </section>

            <section class="bg-card-bg shadow-pixel-hover border-gold w-full rounded-2xl border-3 p-8">
                <div class="mb-6 flex items-center justify-between gap-4">
                    <h2 class="font-pixel text-lg text-gray-800">My Towers</h2>
                    <a
                        href="/towers/@link"
                        data-astro-prefetch="viewport"
                        class="bg-gold shadow-pixel hover:shadow-pixel-hover font-pixel shrink-0 rounded-lg px-4 py-3 text-[0.7rem] text-gray-800 no-underline transition-all hover:-translate-x-0.5 hover:-translate-y-0.5"
                    >
                        + Link a Tower
                    </a>
                </div>

                <div class="rounded-lg border-2 border-dashed border-gray-300 p-8 text-center">
                    <div class="mb-3 text-4xl">🏗️</div>
                    <p class="font-mono mb-1 text-2xl text-gray-600">No towers linked yet</p>
                    <p class="font-mono text-lg text-gray-500">
                        Link your TinyTower save to sync your bitizens and start trading with players worldwide.
                    </p>
                </div>
            </section>

            <section class="bg-card-bg shadow-pixel-hover border-gold w-full rounded-2xl border-3 p-8">
                <h2 class="font-pixel mb-2 text-lg text-gray-800">Sign-In Methods</h2>
                <p class="font-mono mb-6 text-lg text-gray-500">
                    Connect more ways to sign in, so you can always get back to this account.
                </p>

                <div class="flex flex-col gap-4">
                    <a
                        href="/auth/google/login"
                        class="shadow-pixel hover:shadow-pixel-hover hover:border-sky-blue flex items-center gap-3 rounded-lg border-2 border-gray-300 bg-white px-4 py-3 no-underline transition-all hover:-translate-x-0.5 hover:-translate-y-0.5"
                    >
                        <svg class="h-6 w-6 shrink-0" viewBox="0 0 24 24">
                            <path
                                fill="#4285F4"
                                d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                            ></path>
                            <path
                                fill="#34A853"
                                d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                            ></path>
                            <path
                                fill="#FBBC05"
                                d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
                            ></path>
                            <path
                                fill="#EA4335"
                                d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                            ></path>
                        </svg>
                        <span class="font-mono text-xl text-gray-800">Google</span>
                        <span class="font-pixel ml-auto shrink-0 text-[0.6rem] text-gray-500">Connect →</span>
                    </a>

                    <a
                        href="/auth/discord/login"
                        class="shadow-pixel hover:shadow-pixel-hover hover:border-sky-blue flex items-center gap-3 rounded-lg border-2 border-gray-300 bg-white px-4 py-3 no-underline transition-all hover:-translate-x-0.5 hover:-translate-y-0.5"
                    >
                        <svg class="text-discord h-6 w-6 shrink-0" viewBox="0 0 24 24">
                            <path
                                fill="currentColor"
                                d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"
                            ></path>
                        </svg>
                        <span class="font-mono text-xl text-gray-800">Discord</span>
                        <span class="font-pixel ml-auto shrink-0 text-[0.6rem] text-gray-500">Connect →</span>
                    </a>
                </div>
            </section>

            <a
                href="/developers/apps"
                data-astro-prefetch="viewport"
                class="shadow-pixel hover:shadow-pixel-hover hover:border-sky-blue flex w-full items-center gap-3 rounded-lg border-2 border-gray-300 bg-white p-4 no-underline transition-all hover:-translate-x-0.5 hover:-translate-y-0.5"
            >
                <span class="text-2xl">🛠️</span>
                <div class="min-w-0">
                    <div class="font-mono text-xl text-gray-800">Developer Portal</div>
                    <div class="font-mono text-base text-gray-500">
                        Register OAuth apps that sign users in with Tinyburg
                    </div>
                </div>
                <span class="font-pixel ml-auto shrink-0 text-[0.6rem] text-gray-500">→</span>
            </a>
        </div>
    </div>
</CloudsLayout>

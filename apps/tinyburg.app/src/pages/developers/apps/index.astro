---
import { Effect, Option } from "effect";

import { AppRuntime } from "../../../../app/runtime.ts";
import { DevelopersRepository } from "../../../../domain/developers.ts";
import CloudsLayout from "../../../layouts/CloudsLayout.astro";

const maybeAccount = Astro.locals.account;
if (Option.isNone(maybeAccount)) {
    return Astro.redirect(`/login?returnTo=${encodeURIComponent("/developers/apps")}`);
}

const account = maybeAccount.value;
const clients = await DevelopersRepository.pipe(
    Effect.flatMap((repo) => repo.listOAuthClients(account.user.id)),
    Effect.map((clients) => clients.sort((a, b) => a.name.localeCompare(b.name))),
    AppRuntime.runPromise,
);
---

<CloudsLayout
    title="OAuth Applications | Tinyburg"
    description="Register and manage OAuth applications that sign users in with Tinyburg."
>
    <div class="relative z-10 flex min-h-screen flex-col items-center p-8 pt-24">
        <a
            href="/"
            class="font-pixel bg-dark-blue/80 shadow-pixel hover:shadow-pixel-hover absolute top-8 left-8 rounded px-4 py-3 text-[0.7rem] text-white transition-all hover:-translate-x-0.5 hover:-translate-y-0.5"
        >
            ← Back to Home
        </a>

        <div class="bg-card-bg shadow-pixel-hover border-gold w-full max-w-2xl rounded-2xl border-3 p-8">
            <div class="mb-8 flex items-center justify-between gap-4">
                <h1 class="font-pixel text-lg text-gray-800">OAuth Applications</h1>
                <a
                    href="/developers/apps/new"
                    class="bg-gold shadow-pixel hover:shadow-pixel-hover font-pixel shrink-0 rounded-lg px-4 py-3 text-[0.7rem] text-gray-800 no-underline transition-all hover:-translate-x-0.5 hover:-translate-y-0.5"
                >
                    + New Application
                </a>
            </div>

            {
                clients.length === 0 ? (
                    <p class="font-mono text-xl text-gray-600">
                        No applications yet. Register one to let people sign in to your app with their Tinyburg account.
                    </p>
                ) : (
                    <div class="flex flex-col gap-4">
                        {clients.map((client) => (
                            <a
                                href={`/developers/apps/${client.id}`}
                                class="shadow-pixel hover:shadow-pixel-hover hover:border-sky-blue block rounded-lg border-2 border-gray-300 bg-white p-4 no-underline transition-all hover:-translate-x-0.5 hover:-translate-y-0.5"
                            >
                                <div class="font-mono text-2xl text-gray-800">{client.name}</div>
                                <div class="font-mono text-base break-all text-gray-500">{client.id}</div>
                            </a>
                        ))}
                    </div>
                )
            }
        </div>
    </div>
</CloudsLayout>

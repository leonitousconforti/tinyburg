{
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "clean": "node scripts/clean.mjs",
        "codegen": "pnpm --recursive --parallel --filter \"./packages/**/*\" run codegen",
        "build": "tsc -b tsconfig.build.json && pnpm --recursive --parallel --filter \"./packages/**/*\" run build",
        "circular": "node scripts/circular.mjs",
        "test": "vitest",
        "coverage": "vitest --coverage",
        "check": "tsc -b tsconfig.json",
        "check-recursive": "pnpm --recursive --filter \"./packages/**/*\" exec tsc -b tsconfig.json",
        "lint": "oxlint --disable-nested-config && oxfmt --check apps packages scratchpad scripts",
        "lint-fix": "oxlint --disable-nested-config --fix && oxfmt --write apps packages scratchpad scripts",
        "docgen": "pnpm --recursive --filter \"./packages/**/*\" exec docgen && node scripts/docs.mjs",
        "changeset-version": "changeset version",
        "changeset-publish": "pnpm build && changeset publish",
        "prepare": "effect-tsgo patch --typescript --oxlint"
    },
    "devDependencies": {
        "@babel/cli": "8.0.4",
        "@babel/core": "8.0.1",
        "@babel/plugin-transform-export-namespace-from": "8.0.1",
        "@babel/plugin-transform-modules-commonjs": "8.0.1",
        "@changesets/cli": "3.0.1",
        "@changesets/config": "4.0.0",
        "@effect/build-utils": "0.8.9",
        "@effect/docgen": "4.0.0-rc.111",
        "@effect/tsgo": "0.36.5",
        "@types/node": "26.2.0",
        "@vitest/coverage-v8": "4.1.11",
        "babel-plugin-annotate-pure-calls": "0.5.0",
        "effect": "4.0.0-rc.111",
        "glob": "13.0.6",
        "madge": "8.0.0",
        "oxfmt": "0.63.0",
        "oxlint": "1.78.0",
        "oxlint-tsgolint": "7.0.2001",
        "redis": "6.2.1",
        "rimraf": "6.1.3",
        "tsx": "4.23.12",
        "typescript": "7.0.2",
        "vite": "8.2.1",
        "vitest": "4.1.11"
    },
    "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
